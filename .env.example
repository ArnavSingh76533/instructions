# Copy to .env for local Docker only. On Hugging Face, add these as PRIVATE SECRETS.
# Replace every placeholder with YOUR OWN value. Never commit the filled .env file.
TELEGRAM_API_ID=YOUR_NUMERIC_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
OPENCLAW_GATEWAY_TOKEN=GENERATE_YOUR_OWN_LONG_RANDOM_SECRET

# Optional: restrict DMs to comma-separated NUMERIC Telegram user IDs.
# Leave unset to keep the template's open DM policy.
# TELEGRAM_ALLOW_FROM=YOUR_NUMERIC_TELEGRAM_USER_ID
